//| mvnDeps: ["org.buildobjects:docufier:0.1.3"]
package build

import mill.*
import javalib.*
import mill.api.BuildCtx
import mill.javalib.publish.*
import org.buildobjects.doctest.Docufier

import java.io.File

object jsonmatch extends JavaModule, SonatypeCentralPublishModule {

  def publishVersion: T[String] = Task.Input{
    Task.env.getOrElse("PUBLISH_VERSION", throw new Exception("PUBLISH_VERSION not set."))
  }

  def mvnDeps = Seq(
    mvn"com.fasterxml.jackson.core:jackson-core:2.17.0",
    mvn"com.fasterxml.jackson.core:jackson-databind:2.17.0",
    mvn"com.fasterxml.jackson.datatype:jackson-datatype-jdk8:2.17.0",
    mvn"com.fasterxml.jackson.datatype:jackson-datatype-jsr310:2.17.0",
    mvn"com.fasterxml.jackson.module:jackson-module-parameter-names:2.17.0",
    mvn"org.apache.commons:commons-lang3:3.18.0",
    mvn"org.apache.commons:commons-text:1.14.0",
    mvn"com.google.guava:guava:33.4.8-jre",
  )

  def compileMvnDeps = Seq(mvn"org.projectlombok:lombok:1.18.40")

  def processors = Task {
    defaultResolver().classpath(Seq(mvn"org.projectlombok:lombok:1.18.40"))
  }

  def javacOptions = Seq(
    "-processorpath",
    processors().map(_.path).mkString(File.pathSeparator)
  )

  def pomSettings = PomSettings(
    description = "Library for matching json output",
    organization = "berlin.softwaretechnik",
    url = "https://github.com/softwaretechnik-berlin/jsonmatch",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("softwaretechnik-berlin", "jsonmatch"),
    developers = Seq(Developer("fleipold", "Felix Leipold", "https://github.com/fleipold"))
  )

  object test extends JavaTests {
    def testFramework = "com.novocode.junit.JUnitFramework"

    def mvnDeps = Seq(
      mvn"com.novocode:junit-interface:0.11",
      mvn"org.buildobjects:docufier:0.1.3",
      mvn"org.hamcrest:hamcrest:3.0",
    )

    // running the tests in the main directory, so that we can get the output
    override def testSandboxWorkingDir: T[Boolean] = Task {
      false
    }

    def docufy = Task {
      BuildCtx.withFilesystemCheckerDisabled {
        os.copy(BuildCtx.workspaceRoot / "target", os.pwd / "target", mergeFolders = true)
        println("PWD: " + os.pwd)

        println("The truth according to java.io: " + new File(".").getAbsoluteFile)

        for pathRef: PathRef <- sources() yield {
          // fixme: this guy doesn't honour os.pwd and the processes working directory hasn't been changed.
          new Docufier(pathRef.path.toIO, Task.dest.toIO)
        }
      }

      PathRef(Task.dest)
    }
  }
}
